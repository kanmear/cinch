--- /dev/null
+++ i/lib/logic/category/sealed_category.dart
@@ -0,0 +1,21 @@
+import 'package:budgetron/models/category/category.dart';
+
+/// Thrown when a write would add an entry to a sealed category, move one into
+/// it, or edit or delete one in it (ENTRY-008).
+class SealedCategory implements Exception {
+  final String name;
+
+  const SealedCategory(this.name);
+
+  /// Sealing is derived from the name, never stored: a name starting with `#`
+  /// seals its category, so a rename seals or unseals it (ENTRY-008).
+  static bool isSealed(EntryCategory category) => category.name.startsWith('#');
+
+  /// Throws [SealedCategory] when [category] is sealed.
+  static void guard(EntryCategory category) {
+    if (isSealed(category)) throw SealedCategory(category.name);
+  }
+
+  @override
+  String toString() => 'SealedCategory($name)';
+}
