diff --git c/test/logic/entry/entry_service_sealed_test.dart i/test/logic/entry/entry_service_sealed_test.dart
new file mode 100644
index 0000000..8dc6575
--- /dev/null
+++ i/test/logic/entry/entry_service_sealed_test.dart
@@ -0,0 +1,123 @@
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:budgetron/logic/category/sealed_category.dart';
+import 'package:budgetron/logic/entry/entry_service.dart';
+import 'package:budgetron/models/category/category.dart';
+import 'package:budgetron/models/entry.dart';
+import 'package:budgetron/models/money.dart';
+import 'package:budgetron/objectbox.g.dart';
+
+import '../../support/fixtures.dart';
+import '../../support/store_snapshot.dart';
+import '../../support/test_services.dart';
+import '../../support/test_store.dart';
+
+void main() {
+  late Store store;
+  late TestServices services;
+  late EntryService service;
+  late EntryCategory food, vault;
+
+  final day = DateTime(2024, 3, 10, 12);
+
+  EntryUpdate updateTo(EntryCategory category) =>
+      EntryUpdate(amount: const Money(900), dateTime: day, category: category);
+
+  Entry create(EntryCategory category) {
+    final entry = makeEntry(amount: const Money(1250), dateTime: day);
+    service.createEntry(entry, category);
+    return entry;
+  }
+
+  void rename(EntryCategory category, String name) {
+    category.name = name;
+    services.categoryService.updateCategory(category);
+  }
+
+  setUp(() {
+    store = openTestStore();
+    services = TestServices(store);
+    service = services.entryService;
+    food = makeCategory(name: 'Food');
+    vault = makeCategory(name: '#Vault');
+    services.categories.add(food);
+    services.categories.add(vault);
+  });
+  tearDown(() => store.close());
+
+  // cinch:rule ENTRY-008
+  group('sealed categories', () {
+    test('creating an entry in one throws and writes nothing', () {
+      final before = snapshotAll(store);
+      final entry = makeEntry(amount: const Money(1250), dateTime: day);
+
+      expect(
+        () => service.createEntry(entry, vault),
+        throwsA(isA<SealedCategory>()),
+      );
+
+      expect(snapshotAll(store), before);
+      expect(vault.usages, 0);
+      expect(entry.id, 0);
+    });
+
+    test('moving an entry into one throws and writes nothing', () {
+      final entry = create(food);
+      final before = snapshotAll(store);
+
+      expect(
+        () => service.update(entry.id, updateTo(vault)),
+        throwsA(isA<SealedCategory>()),
+      );
+
+      expect(snapshotAll(store), before);
+    });
+
+    test('editing, moving or deleting an entry in one throws', () {
+      final entry = create(food);
+      rename(food, '#Food');
+      final before = snapshotAll(store);
+
+      expect(
+        () => service.update(entry.id, updateTo(food)),
+        throwsA(isA<SealedCategory>()),
+      );
+      expect(
+        () => service.update(
+          entry.id,
+          updateTo(services.categories.get(vault.id)!),
+        ),
+        throwsA(isA<SealedCategory>()),
+      );
+      expect(
+        () => service.deleteEntry(services.entries.get(entry.id)!),
+        throwsA(isA<SealedCategory>()),
+      );
+
+      expect(snapshotAll(store), before);
+    });
+
+    test('renaming to a plain name unseals, renaming to # seals', () {
+      final entry = create(food);
+
+      rename(food, '#Food');
+      expect(() => create(food), throwsA(isA<SealedCategory>()));
+
+      rename(food, 'Food');
+      service.update(entry.id, updateTo(food));
+      service.deleteEntry(services.entries.get(entry.id)!);
+
+      expect(services.entries.count(), 0);
+    });
+
+    test('a plain category is not affected', () {
+      final entry = create(food);
+
+      service.update(entry.id, updateTo(food));
+      service.deleteEntry(services.entries.get(entry.id)!);
+
+      expect(services.entries.count(), 0);
+      expect(services.categories.get(food.id)!.usages, 0);
+    });
+  });
+}
