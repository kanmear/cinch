diff --git c/test/logic/category/category_color_test.dart i/test/logic/category/category_color_test.dart
new file mode 100644
index 0000000..91b5c13
--- /dev/null
+++ i/test/logic/category/category_color_test.dart
@@ -0,0 +1,30 @@
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:budgetron/logic/category/category_color.dart';
+
+void main() {
+  // cinch:rule CAT-002
+  test('a name always gets the same color, from the palette', () {
+    for (final name in ['Groceries', 'Rent', 'Eating Out', 'Кафе', '', ' ']) {
+      expect(categoryColorFor(name), categoryColorFor(name));
+      expect(categoryPalette, contains(categoryColorFor(name)));
+    }
+  });
+
+  // cinch:rule CAT-002
+  test('the color is a fixed function of the name, not of a run', () {
+    // Pinned values: a change here recolors every user's categories.
+    expect(categoryColorFor('Groceries'), categoryPalette[12]);
+    expect(categoryColorFor('Rent'), categoryPalette[16]);
+    expect(categoryColorFor(''), categoryPalette[17]);
+  });
+
+  // cinch:rule CAT-002
+  test('names spread over the palette', () {
+    final used = {
+      for (var i = 0; i < 200; i++) categoryColorFor('Category $i'),
+    };
+
+    expect(used.length, greaterThan(categoryPalette.length ~/ 2));
+  });
+}
