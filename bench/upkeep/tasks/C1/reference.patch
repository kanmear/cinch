diff --git c/lib/logic/category/category_color.dart i/lib/logic/category/category_color.dart
new file mode 100644
index 0000000..efcb6ff
--- /dev/null
+++ i/lib/logic/category/category_color.dart
@@ -0,0 +1,38 @@
+import 'dart:convert';
+import 'dart:ui';
+
+/// The colors a category can have, in a fixed order: [categoryColorFor]
+/// indexes into this list, so reordering or resizing it recolors every
+/// category.
+const List<Color> categoryPalette = [
+  Color(0xffF44336),
+  Color(0xffE91E63),
+  Color(0xff9C27B0),
+  Color(0xff673AB7),
+  Color(0xff3F51B5),
+  Color(0xff2196F3),
+  Color(0xff00BCD4),
+  Color(0xff009688),
+  Color(0xff4CAF50),
+  Color(0xff8BC34A),
+  Color(0xffCDDC39),
+  Color(0xffFFEB3B),
+  Color(0xffFFC107),
+  Color(0xffFF9800),
+  Color(0xffFF5722),
+  Color(0xff795548),
+  Color(0xff607D8B),
+  Color(0xff608b6e),
+];
+
+/// The color of the category called [name] (CAT-002): a hash of the name's
+/// UTF-8 bytes picks an entry of [categoryPalette]. The hash is spelled out
+/// here because `String.hashCode` is not stable across runs or platforms; the
+/// same name always gets the same color. Nothing is stored.
+Color categoryColorFor(String name) {
+  var hash = 5381;
+  for (final byte in utf8.encode(name)) {
+    hash = ((hash * 33) + byte) & 0xFFFFFFFF;
+  }
+  return categoryPalette[hash % categoryPalette.length];
+}
