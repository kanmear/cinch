   return '${negative && quotient != BigInt.zero ? '-' : ''}$quotient';
 }
+
+const _romanDigits = [
+  (900, 'CM'),
+  (500, 'D'),
+  (400, 'CD'),
+  (100, 'C'),
+  (90, 'XC'),
+  (50, 'L'),
+  (40, 'XL'),
+  (10, 'X'),
+  (9, 'IX'),
+  (5, 'V'),
+  (4, 'IV'),
+  (1, 'I'),
+];
+
+/// The whole units of [money] as a Roman numeral, in standard subtractive
+/// form (`1994` is `MCMXCIV`). The minor units (hundredths, as for every
+/// [Currency]) are dropped, truncating toward zero, so `-0.50` is zero. Zero
+/// is `N`, a negative amount is prefixed with `-`, and a value of 4000 or more
+/// repeats `M` (`5000` is `MMMMM`). Text only: [money] is never changed.
+String formatMoneyRoman(Money money) {
+  var units = money.minor.abs() ~/ 100;
+  if (units == 0) return 'N';
+
+  final text = StringBuffer(money.minor < 0 ? '-' : '');
+  text.write('M' * (units ~/ 1000));
+  units %= 1000;
+  for (final (value, numeral) in _romanDigits) {
+    while (units >= value) {
+      text.write(numeral);
+      units -= value;
+    }
+  }
+
+  return text.toString();
+}
diff --git a/test/models/money_format_test.dart b/test/models/money_format_test.dart
