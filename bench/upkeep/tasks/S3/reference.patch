+
+  test('formatMoneyRoman writes the whole units as a Roman numeral', () {
+    const expected = {
+      100: 'I',
+      400: 'IV',
+      900: 'IX',
+      4000: 'XL',
+      9000: 'XC',
+      40000: 'CD',
+      90000: 'CM',
+      199400: 'MCMXCIV',
+      244400: 'MMCDXLIV',
+      399900: 'MMMCMXCIX',
+      500000: 'MMMMM',
+      499900: 'MMMMCMXCIX',
+    };
+
+    expected.forEach((minor, numeral) {
+      expect(formatMoneyRoman(Money(minor)), numeral, reason: '$minor');
+      expect(formatMoneyRoman(Money(-minor)), '-$numeral', reason: '-$minor');
+    });
+  });
+
+  test('formatMoneyRoman drops the minor units and writes zero as N', () {
+    expect(formatMoneyRoman(Money.zero), 'N');
+    expect(formatMoneyRoman(const Money(99)), 'N');
+    expect(formatMoneyRoman(const Money(-99)), 'N');
+    expect(formatMoneyRoman(const Money(199)), 'I');
+    expect(formatMoneyRoman(const Money(-199)), '-I');
+    expect(formatMoneyRoman(const Money(199499)), 'MCMXCIV');
+  });
 }
 
