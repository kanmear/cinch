#!/bin/sh
# Auto-bumps the cinch version fields (version/{major,minor,patch,hotfix}.go)
# and folds the change into the commit that triggered it via amend. See
# conventions/git-conventions.md for the full scheme; .githooks/commit-msg enforces
# the message format this relies on. Single product: one path check, and the
# bump logic lives in the binary (`cinch version bump`) — core is Go.

git_dir=$(git rev-parse --git-dir)
lock_file="$git_dir/.version-hook-running"

# Loop guard: the amend below re-triggers post-commit; bail immediately on reentry.
if [ -f "$lock_file" ]; then
	exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" != "dev" ] && [ "$branch" != "main" ]; then
	exit 0
fi

# Skip merge commits (e.g. the main -> dev sync merge after a hotfix): only
# single-parent commits (squash-merge results) drive a bump. Git auto-resolves
# the version fields on the sync merge itself since each one lives in its own
# file (see conventions/git-conventions.md for why that matters).
parent_count=$(git rev-list --parents -1 HEAD | wc -w)
if [ "$parent_count" -gt 2 ]; then
	exit 0
fi

msg=$(git log -1 --pretty=%s)

bump=""
case "$branch" in
	dev)
		case "$msg" in
			"merge: fix/"*)
				bump="patch" ;;
			"merge: feature/"*|"merge: refactor/"*|"merge: chore/"*)
				bump="minor" ;;
		esac
		;;
	main)
		case "$msg" in
			"merge: hotfix/"*)
				bump="hotfix" ;;
			# hotfix is the only bump on main. The dev -> main release cut is a
			# --no-ff merge (2-parent), already skipped by the parent_count guard
			# above; main inherits dev's version files directly from that merge.
		esac
		;;
esac

if [ -z "$bump" ]; then
	exit 0
fi

if ! git rev-parse HEAD^ >/dev/null 2>&1; then
	exit 0
fi

# Only merge commits that touched the product itself drive a bump: Go sources,
# templates, scaffold, fixtures, or the build files. A docs/decisions-only
# merge, or a merge that only touches version/ (the bump machinery's own
# output), .githooks/, or bin/, lands with no version change.
changed=$(git diff --name-only HEAD^ HEAD)

touched=false
while IFS= read -r f; do
	case "$f" in
		version/*) ;;
		*.go|Makefile|go.mod|go.sum|templates/*|scaffold/*|fixtures/*)
			touched=true ;;
	esac
done <<EOF
$changed
EOF

if [ "$touched" = false ]; then
	exit 0
fi

root=$(git rev-parse --show-toplevel)
CINCH="${CINCH:-$root/bin/cinch}"
if [ ! -x "$CINCH" ]; then
	echo "post-commit: $CINCH not found — skipping auto version bump (run 'make build')" >&2
	exit 0
fi

if "$CINCH" version bump "$bump" && git add version/; then
	touch "$lock_file"
	git commit --amend --no-edit --no-verify
	rm -f "$lock_file"
fi
