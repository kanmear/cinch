#!/bin/sh
# Enforces the `merge: <branch>` commit message format for squash-merge commits
# landing on dev/main — this is the signal .githooks/post-commit relies on to
# decide which part of the version (minor/patch/hotfix) to bump. See
# conventions/git-conventions.md for the full scheme.
#
# Only squash-merge commits are validated (SQUASH_MSG exists only during that
# staged-but-uncommitted window); regular commits on other branches are untouched.
# Ported from project_deltadocs, unchanged: the format is service-agnostic.

git_dir=$(git rev-parse --git-dir)
if [ ! -f "$git_dir/SQUASH_MSG" ]; then
	exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" != "dev" ] && [ "$branch" != "main" ]; then
	exit 0
fi

msg=$(head -n 1 "$1")

case "$branch" in
	dev)
		case "$msg" in
			"merge: feature/"*|"merge: refactor/"*|"merge: chore/"*|"merge: docs/"*|"merge: fix/"*)
				exit 0 ;;
			*)
				echo "commit-msg: squash-merge onto dev must be 'merge: <feature|refactor|fix|chore|docs>/<name>' (got: \"$msg\")" >&2
				exit 1 ;;
		esac
		;;
	main)
		case "$msg" in
			"merge: hotfix/"*)
				exit 0 ;;
			*)
				echo "commit-msg: squash-merge onto main must be 'merge: hotfix/<name>' (got: \"$msg\")" >&2
				exit 1 ;;
		esac
		;;
esac
